{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocket://schemas/ui-style-v1",
  "title": "Pocket UI Style and Theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes", "rules"],
  "properties": {
    "themes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tokens", "base"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "tokens": {"type": "object", "additionalProperties": {"type": "integer"}},
          "base": {"$ref": "#/$defs/style"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["styleRef", "states", "priority", "style"],
        "properties": {
          "styleRef": {"type": "integer", "minimum": 1},
          "states": {"type": "array", "uniqueItems": true, "items": {"enum": ["pressed", "focused", "disabled", "checked", "selected"]}},
          "priority": {"type": "integer", "minimum": 0, "maximum": 65535},
          "style": {"$ref": "#/$defs/style"}
        }
      }
    }
  },
  "$defs": {
    "atom": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["literal"], "properties": {"literal": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["token"], "properties": {"token": {"type": "integer", "minimum": 1}}}
      ]
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "background": {"$ref": "#/$defs/atom"}, "foreground": {"$ref": "#/$defs/atom"},
        "borderColor": {"$ref": "#/$defs/atom"}, "borderWidth": {"$ref": "#/$defs/atom"},
        "radius": {"$ref": "#/$defs/atom"}, "fontId": {"$ref": "#/$defs/atom"},
        "fontSize": {"$ref": "#/$defs/atom"}, "spacing": {"$ref": "#/$defs/atom"},
        "opacity": {"$ref": "#/$defs/atom"}, "translateX": {"$ref": "#/$defs/atom"},
        "translateY": {"$ref": "#/$defs/atom"}
      }
    }
  }
}
