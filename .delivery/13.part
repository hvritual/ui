+    CHECK(key(&d,POCKET_KEY_MODE,0));CHECK(pocket_key_layout_mode(&d.layout,POCKET_LAYOUT_SYMBOLS));CHECK(type(&d,"!"));CHECK(shot(&d,"symbols"));
