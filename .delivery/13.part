+/* Synthetic fixtures only. The production capture API remains forbidden. */
+static int shot(Driver *d,const char *name){
+    char path[4096];CHECK(snprintf(path,sizeof(path),"%s/%s.ppm",d->out,name)<(int)sizeof(path));FILE *out=fopen(path,"wx");CHECK(out);
+    const PocketEngineFrame *f=&d->r->frame;CHECK(fprintf(out,"P6\n%u %u\n255\n",f->width,f->height)>0);
+    for(unsigned y=0;y<f->height;y++)for(unsigned x=0;x<f->width;x++){
+        const uint8_t *p=f->pixels+y*f->stride+x*4;unsigned char pixel[]={p[2],p[1],p[0]};CHECK(fwrite(pixel,1,3,out)==3);
+    }
+    CHECK(!fclose(out));return 1;
+}
+static unsigned le16(const unsigned char *p){return p[0]|((unsigned)p[1]<<8);}
+static uint32_t le32(const unsigned char *p){return p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static int glyph_pixels(Driver *d,const PocketSceneRecord *record,int wrong){
+    const PuiFile *atlas=pui_loaded_file(&d->r->package,"input.atlas");CHECK(atlas&&atlas->length>16);
+    const unsigned char *b=atlas->data;unsigned n=le16(b+6),gid=n;uint32_t cp=(uint32_t)record->text_ref-POCKET_INPUT_GLYPH_BASE;
+    for(unsigned i=0;i<n;i++)if(le32(b+16+i*8)==cp){gid=le16(b+20+i*8);break;}
+    CHECK(gid<n&&16+(size_t)n*8+(size_t)(gid+1)*720<=atlas->length);
+    const unsigned char *coverage=b+16+n*8+gid*720;unsigned ink=0;
+    /* Independently blend the baked cell into the white editor. Font line 36,
+     * cell 30 => 3px vertical centering. Allow only integer rounding +/-1. */
+    for(unsigned y=0;y<30;y++)for(unsigned x=0;x<24;x++){
+        unsigned a=coverage[y*24+x];ink+=a;
+        const unsigned char *pixel=d->r->frame.pixels+(record->bounds.y+3+y)*d->r->frame.stride+(record->bounds.x+x)*4;
+        for(unsigned c=0;c<3;c++){
+            unsigned color=(record->foreground>>((2-c)*8))&255;
+            if(wrong)color=255;
+            unsigned expected=(color*a+255*(255-a)+127)/255;
+            int difference=(int)pixel[c]-(int)expected;
+            if(difference < -1 || difference > 1)fprintf(stderr,"GLYPH_PIXEL x=%u y=%u channel=%u alpha=%u color=%08x expected=%u actual=%u opacity=%u\n",x,y,c,a,record->foreground,expected,pixel[c],record->opacity_256);
+            CHECK(difference>=-1&&difference<=1);
+        }
+    }
+    CHECK(ink>255);return 1;
+}
+static int field(Driver *d,const uint32_t *expected,unsigned length){
+    unsigned seen=0;
+    for(unsigned n=0;n<d->r->scene.count;n++){
+        PocketSceneRecord *r=&d->r->scene.records[n];
+        if(r->kind!=POCKET_COMPONENT_TEXT||r->bounds.y!=160||r->bounds.x<48||r->bounds.x>=912)continue;
+        unsigned at=(unsigned)(r->bounds.x-48)/24;CHECK(at<length);
+        uint64_t ref=expected[at]>126?POCKET_INPUT_GLYPH_BASE+expected[at]:1000+expected[at];CHECK(r->text_ref==ref);if(expected[at]>126)CHECK(glyph_pixels(d,r,0));seen++;
+    }
+    CHECK(seen==length);return 1;
+}
+static int locale(Driver *d,unsigned value){
+    CHECK(key(d,POCKET_KEY_LANGUAGE,0));PocketKeyboardInputSnapshot s;CHECK(meta(d,&s));CHECK(s.language_popup);
+    CHECK(tap(d,512,(int)d->height-256+(value==1?74:134)));CHECK(meta(d,&s));CHECK(!s.language_popup&&s.locale==value&&!s.composing);
+    d->layout.locale=value;return 1;
+}
