+    CHECK(tap(&d,340,(int)height-292));CHECK(wait_candidates(&d));CHECK(meta(&d,&s));CHECK(s.composing);CHECK(field(&d,NULL,0));CHECK(shot(&d,"partial-choice"));
+    CHECK(key(&d,POCKET_KEY_ENTER,0));CHECK(step(&d,20));const uint32_t hello[]={0x4f60,0x597d};CHECK(field(&d,hello,2));CHECK(shot(&d,"committed"));
