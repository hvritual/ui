+  if(c<32||c>65535||(c>=0xd800&&c<=0xdfff)||c<=prev||d.getUint16(at+4,true)>=n||d.getUint8(at+6)!==24||d.getUint8(at+7)!==0)return -1;
+  prev=c;codes.add(c);
