diff --git a/scripts/device/run-input.sh b/scripts/device/run-input.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d77cae2075b1b74490db8d28f7eb95e4373aee77
--- /dev/null
+++ b/scripts/device/run-input.sh
@@ -0,0 +1,6 @@
+#!/bin/sh
+# Explicit development-only input diagnostic; original board restrictions remain.
+set -eu
+BASE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+export FRAMEWORK_APPLICATION=coffee-ime
+exec "$BASE/run-framework.sh" "$@"
