new file mode 100644
index 0000000000000000000000000000000000000000..0ca478fa46245bbd539e08b1d1b147da4b1b0fec
--- /dev/null
+++ b/tests/ime/test_keyboard_view.c
@@ -0,0 +1,209 @@
+#define _POSIX_C_SOURCE 200809L
+#include "hosts/linux/framework.h"
+#include "hosts/linux/text-input/layout.h"
+#include "hosts/linux/text-input/input_font.h"
+#include "tests/framework/frame_oracle.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <errno.h>
+#include <time.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"IME_VIEW_FAIL line=%d %s\n",__LINE__,#x);return 0;}}while(0)
+static int intentional;
+static const char *ordinary_assets;
+typedef struct {PocketFramework *r;uint64_t ms,seq;unsigned height;const char *out;PocketKeyLayoutState layout;} Driver;
+static int step(Driver *d,unsigned delta){d->ms+=delta;int ok=pocket_framework_tick(d->r,d->ms*1000000ULL,1);if(!ok)fprintf(stderr,"RUNTIME_FAIL %s app=%s\n",d->r->error,pocket_application_error(&d->r->app));CHECK(ok);return 1;}
+static int send_frame(Driver *d,InputFrame f){
+    f.sequence=++d->seq;d->ms+=20;int ok=pocket_framework_input(d->r,&f,d->ms*1000000ULL);if(!ok)fprintf(stderr,"INPUT_FAIL %s app=%s\n",d->r->error,pocket_application_error(&d->r->app));CHECK(ok);CHECK(step(d,1));return 1;
+}
+static int contact(Driver *d,int down,int x,int y){
+    InputFrame f={0};if(down){f.contact_count=1;f.contacts[0]=(InputContact){0,x,y};}return send_frame(d,f);
+}
+static int tap(Driver *d,int x,int y){CHECK(contact(d,1,x,y));CHECK(contact(d,0,x,y));return 1;}
+static int meta(Driver *d,PocketKeyboardInputSnapshot *s){CHECK(pocket_application_keyboard_input_snapshot(&d->r->app,s));return 1;}
+static int key(Driver *d,PocketKeyRole role,unsigned codepoint){
+    PocketKeyLayout g;CHECK(pocket_key_layout_build(&d->layout,d->height,&g));
+    for(unsigned n=0;n<g.count;n++)if(g.keys[n].role==role&&(!codepoint||g.keys[n].codepoint==codepoint)){
+        PocketKeyRect r=g.keys[n].bounds;CHECK(tap(d,r.x+r.width/2,r.y+r.height/2));return 1;
+    }
+    CHECK(0);return 0;
+}
+static int type(Driver *d,const char *value){for(const char *p=value;*p;p++)CHECK(key(d,POCKET_KEY_CHAR,(unsigned char)*p));return 1;}
+static int wait_candidates(Driver *d){
+    PocketKeyboardInputSnapshot s;
+    for(unsigned n=0;n<1500;n++){
+        CHECK(me