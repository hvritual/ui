{
  "schema": 1,
  "name": "pocket.ui",
  "status": "experimental-software-only",
  "sdk_facade_version": "0.1-experimental",
  "loader": {
    "format_version": 1,
    "runtime_api": 1,
    "sdk_api": 1,
    "format": "pui-v1-development"
  },
  "targets": [
    "imx6ul-1024x600",
    "imx6ul-1024x800"
  ],
  "supported": {
    "components": [
      "View",
      "Text",
      "Button"
    ],
    "layout": "bounded-absolute-rect",
    "styles": [
      "theme-token",
      "style-rule"
    ],
    "navigation": [
      "push",
      "replace",
      "pop"
    ],
    "events": [
      "tap-next-owner-tick"
    ],
    "bindings": [
      "catalog-textref"
    ]
  },
  "runtime_grants": [
    "ui.core"
  ],
  "custom_surface": {
    "version": "0-experimental",
    "max_primitives": 32,
    "max_factories": 32,
    "primitives": ["rectangle", "axis-line"],
    "updates": "fixed-topology-geometry",
    "lifetime": "parent-page-owned",
    "trust": "trusted-development-only"
  },
  "drawing_protocol": {
    "version":1,"primitive":"polyline","max_points":4096,"max_surfaces":4,
    "max_pixels_per_surface":262144,"stroke_width":1,"style":"theme-background-token",
    "resource":"PDW1","scene_wire":"PSC1-unchanged","trust":"trusted-development-only"
  },
  "field_policy": {
    "catalog_text_refs": "0..65535",
    "action_id": "1..4095",
    "max_pending_actions": 32
  },
  "unsupported": [
    "direct-native-call",
    "arbitrary-custom-draw-path-arc",
    "compiler",
    "TS-execution",
    "arbitrary-dynamic-text",
    "standalone-IME-UI",
    "publisher-authentication",
    "untrusted-code-sandbox",
    "physical-acceptance"
  ],
  "authentication": "none",
  "production_admission": false,
  "physical_hardware": false
}
